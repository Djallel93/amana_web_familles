includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

# phpstan.neon
#
# Ajouté le 10/09/2026 (Section E1 du refactor) — la codebase n'avait
# jusqu'ici aucune analyse statique, seule la discipline de
# `declare(strict_types=1)` déjà en place partout dans app/. Niveau 5
# choisi comme PLANCHER de départ plutôt que le niveau max (9) : ce projet
# n'a jamais été passé au crible d'un analyseur statique, un niveau élevé
# dès le premier lancement produirait des centaines d'erreurs noyant les
# vrais problèmes plutôt que d'aider à les trouver. À monter
# progressivement (6, 7...) une fois le niveau 5 stabilisé — voir le
# prompt d'origine de cette section : "matching the existing code style
# rather than imposing a new one".
parameters:
    level: 5

    paths:
        - app
        - database/migrations
        - routes

    # Larastan déduit les colonnes des modèles en lisant les migrations. Les
    # modèles partagés (Personne, Role, BenevoleProfil… dans amana/shared)
    # ont les leurs dans le paquet : sans ce chemin, chaque `$personne->email`
    # ressortait en `property.notFound` (317 faux positifs sur 414 au premier
    # passage). Le chemin de l'app est répété car la valeur ci-dessous
    # REMPLACE le défaut de Larastan (database/migrations).
    databaseMigrationsPath:
        - database/migrations
        - vendor/amana/shared/database/migrations

    # Laravel résout beaucoup de types (Auth::user(), route model binding,
    # façades) dynamiquement — Larastan sait déjà interpréter la plupart de
    # ces cas via son extension (voir includes: ci-dessus).
    #
    # NB : `checkMissingIterableValueType` et
    # `checkGenericClassInNonGenericObjectType` ont été SUPPRIMÉES de
    # PHPStan 2.x (ils provoquaient « Unexpected item 'parameters › ...' »).
    # Leur comportement est désormais celui par défaut du niveau 6+ ; au
    # niveau 5 ils ne s'appliquent pas, il n'y a donc rien à les remplacer.
    #
    # La baseline (phpstan-baseline.neon) absorbe les signalements déjà
    # présents au moment de l'ajout de la porte de qualité. Ne pas l'élargir
    # à la main : corriger le code, puis la régénérer avec
    # `composer analyse -- --generate-baseline` (qui ne doit que rétrécir).

rules:
    - App\PHPStan\Rules\NoForeignIdOnCrossDatabaseColumnsRule
