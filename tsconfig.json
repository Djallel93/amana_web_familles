{
    "extends": "@vue/tsconfig/tsconfig.dom.json",

    "compilerOptions": {
        "paths": {
            "@/*": ["./resources/js/*"]
        },
        "strict": true,
        "resolveJsonModule": true
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "vite.config.ts"
    ],

    "exclude": [
        "node_modules"
    ]
}
