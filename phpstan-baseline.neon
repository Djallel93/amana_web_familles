# Baseline PHPStan — générée par `composer analyse -- --generate-baseline`.
#
# Elle absorbe les signalements déjà présents dans app/ au moment où
# l'analyse statique a été ajoutée à la porte de qualité (niveau 5, voir
# phpstan.neon) : dette connue, pas des erreurs ignorées par principe. La
# majorité vient de relations Eloquent typées `Model` (propriétés / méthodes
# « introuvables » sur la classe de base) et d'arguments `Model` là où une
# sous-classe est attendue.
#
# Règles d'usage :
#   - le fichier ne doit que RÉTRÉCIR : en corrigeant du code, régénérer la
#     baseline (`composer analyse -- --generate-baseline`) et committer la
#     différence. Ne jamais y ajouter une entrée à la main pour « faire
#     passer » la CI — corriger le code, ou à défaut justifier l'exception.
#   - la baseline est calculée avec PHP 8.4 (celui de la CI).

parameters:
	ignoreErrors:
		-
			message: '#^Strict comparison using \!\=\= between string and false will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: app/Console/Commands/ReparerEncodageFamilles.php

		-
			message: '#^Using nullsafe method call on non\-nullable type Google\\Service\\PeopleService\\PhoneNumber\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: app/Console/Commands/TesterContactsGoogle.php

		-
			message: '#^Variable \$telephone on left side of \?\? always exists and is not nullable\.$#'
