# ═══════════════════════════════════════════════════════════════════════════════════
# .deploy-now/amana_familles_web/.env.template
#
# Template pour le fichier .env de production sur IONOS.
# Même mécanisme que amana_web_planning : le template-renderer-action lit ce
# fichier, substitue chaque $VARIABLE par un secret/env injecté par GitHub
# Actions au build, et écrit le résultat en .env dans le dossier de déploiement.
#
# IMPORTANT : depuis la migration vers amana/shared (21/07/2026), Familles a
# sa PROPRE base (amana_familles) — DB_HOST/DB_NAME/DB_USERNAME/DB_PASSWORD
# ci-dessous NE pointent PLUS vers la même base que amana_web_planning.
# Seule amana_commun (ref_personnes, ref_roles, ref_applications,
# ref_settings, audit_logs — voir bloc AMANA_COMMUN plus bas) reste
# partagée, via des secrets IONOS distincts (DB_COMMUN_*).
# ════════════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────
# APPLICATION IDENTITY & CORE BEHAVIOR
# ───────────────────────────────────────────────────────────────────────────

APP_NAME="AMANA Familles"

APP_ENV=production

APP_DEBUG=false

APP_KEY=
# Généré au build via `php artisan key:generate` — propre à CETTE app,
# ne pas réutiliser la clé de amana_web_planning (chiffrement de session/
# cookies indépendant entre les deux apps malgré la base partagée).

APP_TIMEZONE=UTC

APP_URL=$IONOS_APP_URL
# Sous-domaine dédié à Familles, injecté par IONOS selon le webspace
# lié à CE projet de déploiement (différent de celui de Planning).


# ───────────────────────────────────────────────────────────────────────────
# LOCALIZATION
# ───────────────────────────────────────────────────────────────────────────

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR


# ───────────────────────────────────────────────────────────────────────────
# MAINTENANCE MODE
# ───────────────────────────────────────────────────────────────────────────

APP_MAINTENANCE_DRIVER=file


# ───────────────────────────────────────────────────────────────────────────
# DATABASE CONNECTION — base dédiée à Familles (amana_familles)
# ───────────────────────────────────────────────────────────────────────────
#
# Depuis la migration vers amana/shared (21/07/2026), Familles a sa PROPRE
# base (amana_familles), distincte de celle de Planning (amana_planning) —
# ce n'est plus "la même base MySQL que amana_web_planning" comme le disait
# le commentaire d'origine en tête de ce fichier. Seule amana_commun
# (ref_personnes, ref_roles, ref_applications, ref_settings, audit_logs,
# password_reset_tokens — voir bloc AMANA_COMMUN ci-dessous) reste partagée.

DB_CONNECTION=mysql
DB_HOST=$DB_HOST
DB_PORT=3306
DB_DATABASE=$DB_NAME
DB_USERNAME="$DB_USERNAME"
DB_PASSWORD="$DB_PASSWORD"


# ───────────────────────────────────────────────────────────────────────────
# AMANA_COMMUN — base partagée entre toutes les apps AMANA (amana/shared)
# ───────────────────────────────────────────────────────────────────────────

AMANA_APP_CODE=familles
AMANA_HOME_ROUTE=familles.index
AMANA_COMMUN_CONNECTION=commun

DB_COMMUN_HOST=$DB_COMMUN_HOST
DB_COMMUN_PORT=3306
DB_COMMUN_DATABASE=$DB_COMMUN_NAME
DB_COMMUN_USERNAME="$DB_COMMUN_USERNAME"
DB_COMMUN_PASSWORD="$DB_COMMUN_PASSWORD"


# ───────────────────────────────────────────────────────────────────────────
# SESSIONS
# ───────────────────────────────────────────────────────────────────────────

SESSION_DRIVER=database
# Table `sessions` PROPRE à cette app (voir database/migrations/2026_07_21_
# 000000_create_sessions_table.php — absente jusqu'ici car cette app comptait
# sur la base physique partagée avec amana_web_planning). Se connecter avec
# le même compte (ref_personnes partagée) fonctionne sur les deux apps, mais
# chaque app garde sa propre session/cookie : ce n'est pas du single-sign-on
# au sens strict. Voir le commentaire en tête de cette migration pour le detail.

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


# ───────────────────────────────────────────────────────────────────────────
# FILE STORAGE, QUEUE & CACHE
# ───────────────────────────────────────────────────────────────────────────

FILESYSTEM_DISK=local
# Stockage disque local IONOS pour les documents familles (identity,
# aides_etat, resource) — voir décision 6.4. Pas de S3/Drive.

QUEUE_CONNECTION=sync
# 'sync' par défaut comme Planning (pas de worker dédié). À passer en
# 'database' si les webhooks (géocodage, contact) doivent être traités
# en tâche de fond plutôt qu'en ligne avec la requête HTTP.

CACHE_STORE=database
CACHE_PREFIX=familles
# Préfixe distinct de Planning pour éviter toute collision de clé de cache
# si un jour les deux apps partagent le même store de cache.


# ───────────────────────────────────────────────────────────────────────────
# PHP RUNTIME TUNING
# ───────────────────────────────────────────────────────────────────────────

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12


# ───────────────────────────────────────────────────────────────────────────
# MAIL / SMTP — mêmes credentials IONOS que Planning
# ───────────────────────────────────────────────────────────────────────────

MAIL_MAILER=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=$MAIL_HOST
MAIL_PORT=$MAIL_PORT
MAIL_USERNAME="$MAIL_USERNAME"
MAIL_PASSWORD="$MAIL_PASSWORD"
MAIL_FROM_ADDRESS=$MAIL_USERNAME
MAIL_FROM_NAME="${APP_NAME}"


# ───────────────────────────────────────────────────────────────────────────
# MAKE.COM WEBHOOKS — scénarios dédiés à Familles (distincts de Planning)
# ───────────────────────────────────────────────────────────────────────────

MAKE_GEOCODING_WEBHOOK_URL="$MAKE_GEOCODING_WEBHOOK_URL"
# Scénario Make.com : adresse → { latitude, longitude, formatted_address }.
# Reçoit { adresse, code_postal, ville }. Voir config/services.php.

MAKE_GEOCODING_WEBHOOK_APIKEY="$MAKE_GEOCODING_WEBHOOK_APIKEY"

MAKE_CONTACT_WEBHOOK_URL="$MAKE_CONTACT_WEBHOOK_URL"
# Scénario Make.com : synchronisation contact Google à la validation
# d'un dossier famille. Voir config/services.php.

MAKE_CONTACT_WEBHOOK_APIKEY="$MAKE_CONTACT_WEBHOOK_APIKEY"


# ───────────────────────────────────────────────────────────────────────────
# LOGGING
# ───────────────────────────────────────────────────────────────────────────

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
